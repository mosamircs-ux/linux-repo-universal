[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Access and organize files, disks, and network shares
Exec=aether-files %U
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;Utility;
MimeType=inode/directory;
Keywords=folder;manager;explore;disk;filesystem;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=aether-files
