[Desktop Entry]
Type=Application
Name=Aether System Monitor
GenericName=System Monitor & Task Manager
Comment=View system CPU, RAM, Network usage and manage active processes
Exec=aether-monitor
Icon=org.gnome.SystemMonitor
Terminal=false
Categories=System;Monitor;
